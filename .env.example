# Copy to .env and fill in values for your environment.
DATABASE_URL="mysql://user:password@localhost:3306/greyjaycare_dev"

AUTH_SECRET="run: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Server-side key used by Places Autocomplete, Place Details, and distance lookup.
GOOGLE_MAPS_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

MAIL_MAILER=smtp
MAIL_HOST=""
MAIL_PORT=""
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls
EMAIL_FROM="bookings@greyjaycare.ca"
# Set only in automated/staging environments that must never send real mail.
DISABLE_OUTBOUND_EMAIL="false"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
